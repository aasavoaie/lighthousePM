# App
APP_NAME=Jira Release Signals
APP_ENV=dev
APP_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lighthouse
# Local file alternative (no PostgreSQL server required):
# DATABASE_URL=sqlite+pysqlite:///./data/lighthouse.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Jira Cloud connection (required for sync endpoints)
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_USER_EMAIL=you@example.com
JIRA_API_TOKEN=your_api_token_here
JIRA_TIMEOUT_SECONDS=30.0
JIRA_MAX_RETRIES=2

# Jira sync v1 (single configured project)
JIRA_PROJECT_KEY=YOURPROJECT
# Keep false for local API-only work. Set true when Jira creds/project are configured.
JIRA_SYNC_ENABLED=false
JIRA_SYNC_PAGE_SIZE=50
JIRA_SYNC_CHANGELOG_PAGE_SIZE=100

# Jira field mapping (override per Jira instance)
# Severity source used by sync/analytics; default keeps current behavior.
JIRA_FIELD_SEVERITY=priority
# Release association source from issue payload; default Jira fixVersions.
JIRA_FIELD_RELEASE=fixVersions
# Sprint association source from issue payload; set to the Jira sprint custom field.
JIRA_FIELD_SPRINT=
# Story points field key (optional, currently mapped for explicit config only).
JIRA_FIELD_STORY_POINTS=
# Optional blocker flag field key; when present and populated, it overrides heuristic detection.
JIRA_FIELD_BLOCKER=
# Truthy values for blocker field matching (case-insensitive).
JIRA_BLOCKER_TRUE_VALUES=true,yes,1,blocker
# Changelog field aliases treated as fix-version changes for scope churn.
JIRA_CHANGELOG_FIX_VERSION_FIELDS=fix version,fixversion
# Changelog field aliases treated as sprint membership changes.
JIRA_CHANGELOG_SPRINT_FIELDS=sprint

# Jira value classifications (comma-separated, trimmed, case-insensitive)
JIRA_DONE_STATUSES=done,closed,resolved
JIRA_IN_PROGRESS_STATUSES=in progress,in development,in review,in testing
JIRA_HIGH_SEVERITY_VALUES=high,highest,critical
JIRA_BUG_ISSUE_TYPES=bug
# Fallback blocker classification used when the explicit blocker field is absent.
# Any fallback category may be left empty deliberately.
JIRA_BLOCKER_ISSUE_TYPES=blocker,incident
JIRA_BLOCKER_SEVERITY_VALUES=blocker,highest,critical
JIRA_BLOCKED_STATUSES=blocked

# Scheduled sync (background)
# Set > 0 to enable periodic sync, e.g. 3600 for hourly.
# Set to 0 (default) to disable the scheduler entirely.
# The manual POST /sync/jira endpoint is unaffected by this setting.
JIRA_SYNC_INTERVAL_SECONDS=0
