APP_NAME=Jira Release Signals
APP_ENV=dev
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/lighthouse
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Jira Cloud connection
JIRA_BASE_URL=https://yourcompany.atlassian.net
JIRA_USER_EMAIL=you@example.com
JIRA_API_TOKEN=your_api_token_here
JIRA_TIMEOUT_SECONDS=30.0
JIRA_MAX_RETRIES=2

# Jira sync v1 (single configured project)
JIRA_PROJECT_KEY=YOURPROJECT
JIRA_SYNC_ENABLED=true
JIRA_SYNC_PAGE_SIZE=50
JIRA_SYNC_CHANGELOG_PAGE_SIZE=100
